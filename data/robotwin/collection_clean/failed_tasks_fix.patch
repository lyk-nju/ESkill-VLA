+def _expert_method(task, **namespace):
+    tree = ast.parse((Path(__file__).resolve().parents[1] / "envs" / f"{task}.py").read_text())
+    method = next(node for node in ast.walk(tree) if isinstance(node, ast.FunctionDef) and node.name == "play_once")
+    exec(compile(ast.Module(body=[method], type_ignores=[]), task, "exec"), namespace)
+    return namespace["play_once"]
+
+
+def test_unreachable_alarm_pose_is_an_expert_failure_before_any_action():
+    method = _expert_method("click_alarmclock", ArmTag=str)
+    task = SimpleNamespace(alarm=SimpleNamespace(get_pose=lambda: SimpleNamespace(p=np.array([.1, 0, .8]))),
+                           get_grasp_pose=lambda *a, **k: None, plan_success=True, info={})
+    assert method(task) == {}
+    assert task.plan_success is False
+
+
